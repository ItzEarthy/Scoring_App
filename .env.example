# Copy this file to .env and adjust as needed.
# .env is read by `docker compose` for variable substitution, and by Prisma/Next.js locally.

# --- Local (non-Docker) tooling: Prisma CLI, `npm run dev`, `npm run seed` ---
DATABASE_URL="postgresql://scoring_app:scoring_app@localhost:5432/scoring_app?schema=public"
# Only needed outside Docker Compose, where there's no `realtime` hostname to
# resolve -- run the relay locally with `npm run dev:realtime`.
REALTIME_INTERNAL_URL="http://localhost:3001"

# --- Auth.js (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-secret"
AUTH_URL="http://localhost:3000"

# --- Docker Compose: postgres container credentials ---
# Used by the `db` service and to build the in-network DATABASE_URL for the
# `app`/`migrate` services (postgresql://<user>:<password>@db:5432/<db>).
POSTGRES_USER=scoring_app
POSTGRES_PASSWORD=scoring_app
POSTGRES_DB=scoring_app

# --- Realtime relay (live match scoreboard) ---
# Self-hosted WebSocket pub/sub server (realtime/), run as its own container
# alongside `app` -- no third-party realtime service is used.
# Generate with: openssl rand -base64 32
REALTIME_SHARED_SECRET="replace-with-a-generated-secret"
# Must be reachable from the *browser*, not just other containers -- point it
# at wherever the `realtime` service's port is published/proxied publicly.
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
