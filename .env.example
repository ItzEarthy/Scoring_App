# Copy this file to .env and adjust as needed.
# .env is read by `docker compose` for variable substitution, and by Prisma/Next.js locally.

# --- Local (non-Docker) tooling: Prisma CLI, `npm run dev`, `npm run seed` ---
DATABASE_URL="postgresql://scoring_app:scoring_app@localhost:5432/scoring_app?schema=public"

# --- Auth.js (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-secret"
AUTH_URL="http://localhost:3000"

# --- Docker Compose: postgres container credentials ---
# Used by the `db` service and to build the in-network DATABASE_URL for the
# `app`/`migrate` services (postgresql://<user>:<password>@db:5432/<db>).
POSTGRES_USER=scoring_app
POSTGRES_PASSWORD=scoring_app
POSTGRES_DB=scoring_app
