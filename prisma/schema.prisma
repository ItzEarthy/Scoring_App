// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  MEMBER
  ADMIN
  OWNER
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  PENDING_CONFIRMATION
  COMPLETED
  CANCELED
  DISPUTED
}

enum MatchOutcome {
  WIN
  LOSS
  DRAW
}

enum QueueStatus {
  WAITING
  MATCHED
  CANCELED
}

enum CourtStatus {
  AVAILABLE
  IN_USE
  DISABLED
}

enum MatchEventType {
  POINT
  UNDO
  MATCH_STARTED
}

// ---------------------------------------------------------------------------
// Auth.js v5 models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  passwordHash  String    @map("password_hash")
  avatarBase64  String?   @map("avatar_base64") @db.Text
  isSiteAdmin   Boolean   @default(false) @map("is_site_admin")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts          Account[]
  sessions          Session[]
  organizationUsers OrganizationUser[]
  playerRatings     PlayerRating[]
  matchParticipants MatchParticipant[]
  queueEntries      QueueEntry[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model Organization {
  id             String   @id @default(cuid())
  name           String
  logoBase64     String?  @map("logo_base64") @db.Text
  platformConfig Json     @map("platform_config") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organizationUsers  OrganizationUser[]
  matches            Match[]
  playerRatings      PlayerRating[]
  queueEntries       QueueEntry[]
  organizationSports OrganizationSport[]
  courts             Court[]

  @@map("organizations")
}

model Sport {
  id              String   @id @default(cuid())
  name            String   @unique
  ratingAlgorithm String   @map("rating_algorithm")
  defaultRules    Json     @map("default_rules") @db.JsonB
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  playerRatings      PlayerRating[]
  matches            Match[]
  queueEntries       QueueEntry[]
  organizationSports OrganizationSport[]
  courts             Court[]

  @@map("sports")
}

// ---------------------------------------------------------------------------
// Junctions & intersections
// ---------------------------------------------------------------------------

model OrganizationUser {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("organization_users")
}

model OrganizationSport {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  sportId        String   @map("sport_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sport        Sport        @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sportId])
  @@map("organization_sports")
}

model Court {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  sportId        String?     @map("sport_id")
  name           String
  status         CourtStatus @default(AVAILABLE)
  displayOrder   Int         @default(0) @map("display_order")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sport        Sport?       @relation(fields: [sportId], references: [id], onDelete: SetNull)
  matches      Match[]

  @@unique([organizationId, name])
  @@index([organizationId, displayOrder])
  @@map("courts")
}

model PlayerRating {
  id             String  @id @default(cuid())
  userId         String  @map("user_id")
  organizationId String  @map("organization_id")
  sportId        String  @map("sport_id")
  mu             Float   @default(25.0)
  sigma          Float   @default(8.333)
  isActive       Boolean @default(true) @map("is_active")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sport        Sport        @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, sportId])
  @@map("player_ratings")
}

// ---------------------------------------------------------------------------
// Match engine & immutable ledger
// ---------------------------------------------------------------------------

model Match {
  id                 String      @id @default(cuid())
  organizationId     String      @map("organization_id")
  sportId            String      @map("sport_id")
  courtId            String?     @map("court_id")
  status             MatchStatus @default(PENDING_CONFIRMATION)
  approvalDeadline   DateTime?   @map("approval_deadline")
  reportedWinnerTeam String?     @map("reported_winner_team")
  reportedByUserId   String?     @map("reported_by_user_id")
  createdAt          DateTime    @default(now()) @map("created_at")
  finishedAt         DateTime?   @map("finished_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sport        Sport              @relation(fields: [sportId], references: [id], onDelete: Cascade)
  court        Court?             @relation(fields: [courtId], references: [id], onDelete: SetNull)
  participants MatchParticipant[]
  queueEntries QueueEntry[]
  events       MatchEvent[]

  @@map("matches")
}

model MatchParticipant {
  id             String        @id @default(cuid())
  matchId        String        @map("match_id")
  userId         String        @map("user_id")
  teamIdentifier String        @map("team_identifier")
  score          Int?
  outcome        MatchOutcome?

  // Ledger fields: historical snapshot of rating state around this match
  muBefore    Float  @map("mu_before")
  sigmaBefore Float  @map("sigma_before")
  muAfter     Float? @map("mu_after")
  sigmaAfter  Float? @map("sigma_after")

  match  Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  events MatchEvent[]

  @@unique([matchId, userId])
  @@map("match_participants")
}

// ---------------------------------------------------------------------------
// Live scoreboard event log (append-only; drives real-time score updates)
// ---------------------------------------------------------------------------

model MatchEvent {
  id              String         @id @default(cuid())
  matchId         String         @map("match_id")
  participantId   String?        @map("participant_id")
  type            MatchEventType
  delta           Int            @default(0)
  createdByUserId String         @map("created_by_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")

  match       Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  participant MatchParticipant? @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@map("match_events")
}

// ---------------------------------------------------------------------------
// Matchmaking queue
// ---------------------------------------------------------------------------

model QueueEntry {
  id             String      @id @default(cuid())
  userId         String      @map("user_id")
  organizationId String      @map("organization_id")
  sportId        String      @map("sport_id")
  status         QueueStatus @default(WAITING)
  matchId        String?     @map("match_id")
  joinedAt       DateTime    @default(now()) @map("joined_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sport        Sport        @relation(fields: [sportId], references: [id], onDelete: Cascade)
  match        Match?       @relation(fields: [matchId], references: [id], onDelete: SetNull)

  // Prevents a player from having two simultaneous WAITING entries for the
  // same org+sport, while still allowing new entries after MATCHED/CANCELED.
  @@unique([userId, organizationId, sportId, status])
  @@map("queue_entries")
}
